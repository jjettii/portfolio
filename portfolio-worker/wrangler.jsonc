{
  "name": "portfolio-worker",
  "main": "index.js",
  "account_id": "08fd4671b2572c7563fbb3cfefb2c662",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "vars": {
    "R2_BUCKET_NAME": "review-uploads",
    // Deferred by owner (2026-11-03). Keep disabled; see digests.js TODO before resuming.
    "COMMENT_DIGEST_ENABLED": "false",
    "COMMENT_DIGEST_TO": "mail@jordanettinger.com",
    "COMMENT_DIGEST_FROM": "reviews@notify.jordanettinger.com",
    "REVIEW_SITE_URL": "https://jordanettinger.com"
  },
  "triggers": { "crons": ["* * * * *"] },
  "send_email": [
    { "name": "COMMENT_EMAIL", "destination_address": "mail@jordanettinger.com" }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "review-uploads"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "review-comments",
      "database_id": "05a73447-fa19-465b-b838-49c3c95e62da",
      "migrations_dir": "migrations"
    }
  ]
}
